# Leave these unset to use the persistent local SQLite database at data/worshiply.db.
# On a server with ephemeral disk, configure a remote Turso database instead.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Optional canonical origin for stricter deployment origin validation.
# APP_ORIGIN=https://your-domain.example
