# Leave these unset to use the persistent local SQLite database at data/worshiply.db.
# Required on Vercel: configure a remote Turso database to preserve songs across deployments.
# Set both variables in Vercel's Production environment and redeploy.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Optional canonical origin for stricter deployment origin validation.
# APP_ORIGIN=https://your-domain.example
