# Leave these unset to use the persistent local SQLite database at data/worshiply.db.
# Required on Vercel: configure a remote Turso database to preserve songs across deployments.
# Set both variables in Vercel's Production environment and redeploy.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Required to sign in as admin. The admin account is created or updated from
# these on startup; changing them replaces the admin and signs it out.
# Username: 3-40 letters, numbers, dots, dashes, or underscores. Password: 10-200 characters.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Optional canonical origin for stricter deployment origin validation.
# APP_ORIGIN=https://your-domain.example
